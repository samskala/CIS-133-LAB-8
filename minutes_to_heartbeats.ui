<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings />
    <customwidgets />
    <resources />
  </project>
  <object class="ttk.Frame" id="top_frame" named="True">
    <property name="borderwidth">1</property>
    <property name="cursor">arrow</property>
    <property name="height">400</property>
    <property name="padding">5</property>
    <property name="takefocus">true</property>
    <property name="width">400</property>
    <layout manager="grid">
      <property name="column">0</property>
      <property name="row">0</property>
      <property name="sticky">nsew</property>
    </layout>
    <child>
      <object class="pygubu.forms.ttkwidget.Label" id="lbl_title" named="True">
        <property name="background">#d9d9d9</property>
        <property name="borderwidth">1</property>
        <property name="font">{Arial} 16 {bold}</property>
        <property name="foreground">#000000</property>
        <property name="justify">center</property>
        <property name="padding">10 0 10 0</property>
        <property name="text" translatable="yes">Minutes to Heartbeats</property>
        <property name="textvariable">string:lbl_title_txt</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">0</property>
          <property name="sticky">n</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="chld1_frame" named="True">
        <property name="height">200</property>
        <property name="padding">10</property>
        <property name="width">200</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">1</property>
          <property name="sticky">ew</property>
        </layout>
        <child>
          <object class="pygubu.forms.ttkwidget.Label" id="lbl_num_minutes" named="True">
            <property name="background">#d9d9d9</property>
            <property name="font">{Arial} 12</property>
            <property name="foreground">#000000</property>
            <property name="justify">left</property>
            <property name="padding">5 0 5 0</property>
            <property name="text" translatable="yes">Number of Minutes:</property>
            <property name="textvariable">string:lbl_num_minutes_txt</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">0</property>
              <property name="sticky">nsew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="pygubu.forms.ttkwidget.Entry" id="ent_num_minutes" named="True">
            <property name="font">{Arial} 12</property>
            <property name="justify">left</property>
            <property name="takefocus">true</property>
            <property name="textvariable">string:ent_num_minutes_txt</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="row">0</property>
              <property name="sticky">nsew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="btn_calculate" named="True">
            <property name="command" type="command" cbtype="simple">calculate_heartbeats</property>
            <property name="padding">5</property>
            <property name="text" translatable="yes">Calculate</property>
            <property name="textvariable">string:btn_calculate_txt</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="pady">10 0</property>
              <property name="row">1</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="chld2_frame" named="True">
        <property name="height">200</property>
        <property name="padding">10</property>
        <property name="width">200</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">3</property>
          <property name="sticky">ew</property>
        </layout>
        <child>
          <object class="pygubu.forms.ttkwidget.Label" id="lbl_num_heartbeats" named="True">
            <property name="font">{Arial} 12</property>
            <property name="justify">left</property>
            <property name="padding">5 0 5 0</property>
            <property name="text" translatable="yes">Number of Heartbeats:</property>
            <property name="textvariable">string:lbl_num_heartbeats_txt</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="pygubu.forms.ttkwidget.Entry" id="ent_num_heartbeats" named="True">
            <property name="font">{Arial} 12</property>
            <property name="state">readonly</property>
            <property name="textvariable">string:ent_num_heartbeats_txt</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator1">
        <property name="orient">horizontal</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">2</property>
          <property name="sticky">ew</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
